@inproceedings{hungr-miccai-2011,
 abstract = {This paper introduces a new patient-mounted CT and MRI guided interventional
radiology robot for percutaneous needle interventions. The 5

DOF robot uses ultrasonic motors and pneumatics to position the needle
and then insert it progressively. The needle position and inclination
can be

registered in the images using two strategically placed fiducials
visible in both imaging modalities. A first prototype is presented
and described in terms of its sterilization, CT and MRI compatibility,
and precision. Tests showed that 1) it is entirely sterilizable with
hydrogen peroxide gas, 2) no image artifacts or deformations are
noticeable in the CT and MRI images, 3) does not affect the SNR of
MR images, and 4) its mechanical error is less than 5mm.},
 address = {Toronto, Canada},
 author = {Hungr, Nikolaï and Fouard, Céline and Robert, Adeline and Bricault,
Ivan and Cinquin, Philippe},
 booktitle = {Proceedings of the 14th international conference on Medical image
Ccomputing and Computer-Assisted Intervention},
 doi = {10.1007/978-3-642-23623-5_18},
 editor = {Fichtinger, Gabor and Martel, Anne and Peters, Terry},
 file = {pdf file preprint (local):pdf/hungr-miccai-2011-soumis.pdf:PDF;papier publié:pdf/hungr-miccai-2011.pdf:PDF},
 owner = {cfouard},
 pages = {137--144},
 publisher = {Springer-Verlag},
 timestamp = {2012.02.14},
 title = {Interventional radiology robot for CT and MRI guided percutaneous
interventions},
 url = {http://dx.doi.org/10.1007/978-3-642-23623-5_18},
 volume = {6891},
 year = {2011}
