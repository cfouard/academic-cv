@inproceedings{strand-dgci-2006,
 abstract = {A sequential algorithm for computing the distance map using distances
based on neighbourhood sequences (of any length) in the 2D square
grid; and 3D cubic, face-centered cubic, and body-centered cubic
grids is presented. Conditions for the algorithm to produce correct
results are derived using a path-based approach. Previous sequential
algorithms for this task have been based on algorithms that compute
the digital Euclidean distance transform. It is shown that the latter
approach is not well-suited for distances based on neighbourhood
sequences.},
 author = {Strand, Robin and Nagy, Benedek and Fouard, Céline and Borgefors,
Gunilla},
 booktitle = {Discrete Geometry for Computer Imagery},
 doi = {10.1007/11907350_25},
 editor = {Kuba, Attila and Nyúl, László and Palágyi, Kálmán},
 file = {pdf file (local):pdf/strand-dgci-2006.pdf:PDF},
 keywords = {Discrete Geometry},
 month = {October},
 owner = {cfouard},
 pages = {295--307},
 publisher = {Springer Berlin / Heidelberg},
 series = {LNCS},
 timestamp = {2012.02.14},
 title = {Generating Distance Maps with Neighbourhood Sequences},
 url = {http://dx.doi.org/10.1007/11907350_25},
 volume = {4245},
 year = {2006}
}

