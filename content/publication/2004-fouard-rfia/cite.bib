@inproceedings{fouard-rfia-2004,
 abstract = {Représentation compacte permettant une analyse mathématique, le squelette
doit être homotope, fin et centré par rapport à l'objet qu'il représente.
De nombreuses approches existent pour le calculer, et les auteurs
s'attachent en particulier à présenter des algorithmes efficaces.
Cependant, dans le cas de grands volumes de données, qu'il n'est
pas possible de conserver dans la mémoire d'un ordinateur personnel,
ces approches ne sont pas directement applicables. Nous présentons
ici, dans le cadre d'une application visant à étudier la microvascularisation
du cerveau, un algorithme de squelettisation travaillant localement
(sur des sous-images) mais qui garde des propriétés globales (localisation).
Nous montrerons les résultats obtenus sur une mosaïque d'images 3D
acquises à l'aide d'un microscope confocal.},
 address = {Toulouse, France},
 author = {Fouard, Céline and Malandain, Grégoire and Prohaska, Steffen and
Westerhoff, Malte and Cassot, Francis and Mazel, Christophe and Asselot,
Didier and Marc-Vergnes, Jean-Pierre},
 booktitle = {Proceedings of 15ème Congrès Francophone Reconnaissance des Formes
et Intelligence Artificielle, RFIA 2004},
 file = {:pdf/fouard-rfia-2004.pdf:PDF},
 month = {Janvier},
 owner = {cfouard},
 timestamp = {2012.02.14},
 title = {Squelettisation par blocs pour de grands volumes de données 3D: application
à la microcirculation cérébrale},
 year = {2004}
}

